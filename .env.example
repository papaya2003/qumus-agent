# OpenAI Agents SDK / Token Station. Copy to .env; never commit real keys.
QUMUS_OPENAI_API_KEY=
QUMUS_OPENAI_BASE_URL=https://physics.bytefuture.ai/v1
# Responses tools, images and web search verified on this endpoint (2026-10-25).
# chat_completions is also supported, without hosted web search.
QUMUS_OPENAI_API=responses
# Gateway-safe transport: receive a complete reply, then emit SDK progress.
# Set 1 only after testing the endpoint's streamed tool-call separation.
QUMUS_OPENAI_STREAM=0
# Complete model ID from your account, including openai/ if required.
QUMUS_OPENAI_MODEL=
# Optional override of the administrator catalog's input + output context limit.
# Applies only to QUMUS_OPENAI_MODEL. Blank uses the catalog, or unknown if unlisted.
QUMUS_OPENAI_CONTEXT_WINDOW_TOKENS=
# Your gateway token rates (USD per million); both are required for USD caps.
# Set both to 0 only when the sponsor confirms model calls are unmetered/free.
QUMUS_OPENAI_INPUT_USD_PER_MILLION=
QUMUS_OPENAI_OUTPUT_USD_PER_MILLION=
# Optional cache-read rate for this model; blank settles all input at the ordinary rate.
# Reservations assume no cache hit. Use a rate verified for this gateway/account.
QUMUS_OPENAI_CACHED_INPUT_USD_PER_MILLION=
# Hosted web search is opt-in and requires compatible Responses support.
QUMUS_OPENAI_WEB_SEARCH=1
# Shared estimated-spend ledger across test databases (do not delete to reset spend).
# Explicitly authorized stage-only opt-out: unlimited. Workspace/request guards remain.
# Estimates use configured token rates; they are not provider-reported charges.
QUMUS_OPENAI_STAGE_BUDGET_USD=200
QUMUS_OPENAI_TEST_BUDGET_USD=40
QUMUS_OPENAI_BUDGET_DB=runs/openai-budget.db
